{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/rentflow-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "RentFlowDb": "Host=localhost;Port=5432;Database=rentflow;Username=postgres;Password=postgres",
    "Redis": "localhost:6379",
    "BlobStorage": "",
    "RabbitMq": ""
  },
  "BlobStorage": {
    "ContainerName": "contracts"
  },
  "Jwt": {
    "Issuer": "RentFlow",
    "Audience": "RentFlow.Clients",
    "SigningKey": "dev-only-signing-key-change-me-in-production-0123456789",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  }
}
