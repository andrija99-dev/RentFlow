# Template for the local .env file consumed by Docker Compose.
# Copy this to .env and fill in real values; .env is gitignored and never committed.

# JWT signing key for the Test stack (HMAC-SHA256, min 32 chars).
# Generate one, e.g. PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SIGNING_KEY=
